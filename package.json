{
  "name": "dnd-dm-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic D&D 2024 rules engine + CLI for running adventures as DM.",
  "type": "module",
  "bin": {
    "dnd": "bin/dnd"
  },
  "scripts": {
    "test": "node --test \"src/**/*.test.ts\"",
